<?xml version="1.0" encoding="UTF-8"?>
<!-- db.changelog-v1.0.2-init.xml -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!--     liquibase ni table laridan shuni ochiramiz-->
    <!--    v1.0.2-tag id lik changeSetni-->
    <changeSet id="1775503509690-1" author="Alibek" runOnChange="false">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="faculties"/>
                <tableExists tableName="groups"/>
                <tableExists tableName="roles"/>
                <tableExists tableName="rooms"/>
                <tableExists tableName="session_users"/>
                <tableExists tableName="students"/>
                <tableExists tableName="subjects"/>
                <tableExists tableName="teachers"/>
                <tableExists tableName="universities"/>
                <tableExists tableName="university_attachment_urls"/>
                <tableExists tableName="user_roles"/>
                <tableExists tableName="users"/>
                <tableExists tableName="zamdekan"/>
            </not>
        </preConditions>

        <createTable tableName="faculties">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_faculties"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column defaultValueBoolean="false" name="is_deleted" type="BOOLEAN"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="nomi" type="VARCHAR(100)"/>
            <column name="add" type="VARCHAR(255)"/>
            <column name="university_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="groups">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_groups"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column defaultValueBoolean="false" name="is_deleted" type="BOOLEAN"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="group_number" type="VARCHAR(255)"/>
            <column name="faculty_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="roles">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_roles"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column defaultValueBoolean="false" name="is_deleted" type="BOOLEAN"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="code" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="rooms">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_rooms"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column defaultValueBoolean="false" name="is_deleted" type="BOOLEAN"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="room_number" type="VARCHAR(255)"/>
            <column name="group_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="session_users">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_session_users"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column defaultValueBoolean="false" name="is_deleted" type="BOOLEAN"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="user_id" type="BIGINT"/>
            <column name="access_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="refresh_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="students">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_students"/>
            </column>
            <column name="age" type="INT"/>
            <column name="student_status" type="VARCHAR(255)"/>
            <column name="group_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="subjects">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_subjects"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column defaultValueBoolean="false" name="is_deleted" type="BOOLEAN"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="teachers">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_teachers"/>
            </column>
            <column name="salary" type="DOUBLE"/>
            <column name="qualification" type="VARCHAR(255)"/>
            <column name="experience" type="VARCHAR(255)"/>
            <column name="subject_id" type="BIGINT"/>
            <column name="faculty_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="universities">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_universities"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column defaultValueBoolean="false" name="is_deleted" type="BOOLEAN"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="website" type="VARCHAR(255)"/>
            <column name="logo" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="university_attachment_urls">
            <column name="university_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="attachment_urls" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="user_roles">
            <column name="role_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_roles"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_roles"/>
            </column>
        </createTable>

        <createTable tableName="users">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_users"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column defaultValueBoolean="false" name="is_deleted" type="BOOLEAN"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="gender" type="VARCHAR(255)"/>
            <column name="birth_date" type="DATE"/>
            <column name="address" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="zamdekan">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_zamdekan"/>
            </column>
            <column name="faculty_id" type="BIGINT"/>
        </createTable>

        <addUniqueConstraint columnNames="nomi" constraintName="uc_faculties_nomi" tableName="faculties"/>
        <addUniqueConstraint columnNames="user_id" constraintName="uc_session_users_user" tableName="session_users"/>
        <addUniqueConstraint columnNames="subject_id" constraintName="uc_teachers_subject" tableName="teachers"/>
        <addUniqueConstraint columnNames="username" constraintName="uc_users_username" tableName="users"/>

        <addForeignKeyConstraint baseColumnNames="university_id" baseTableName="faculties"
                                 constraintName="FK_FACULTY_ON_UNIVERSITY" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="universities" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="faculty_id" baseTableName="groups"
                                 constraintName="FK_GROUPS_ON_FACULTY" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="faculties" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="group_id" baseTableName="rooms"
                                 constraintName="FK_ROOMS_ON_GROUP" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="groups" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="session_users"
                                 constraintName="FK_SESSION_USERS_ON_USER" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="users" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="group_id" baseTableName="students"
                                 constraintName="FK_STUDENTS_ON_GROUP" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="groups" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="students"
                                 constraintName="FK_STUDENTS_ON_USER" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="users" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="faculty_id" baseTableName="teachers"
                                 constraintName="FK_TEACHERS_ON_FACULTY" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="faculties" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="subject_id" baseTableName="teachers"
                                 constraintName="FK_TEACHERS_ON_SUBJECT" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="subjects" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="teachers"
                                 constraintName="FK_TEACHERS_ON_USER" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="users" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="faculty_id" baseTableName="zamdekan"
                                 constraintName="FK_ZAMDEKAN_ON_FACULTY" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="faculties" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="zamdekan"
                                 constraintName="FK_ZAMDEKAN_ON_USER" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="users" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="university_id" baseTableName="university_attachment_urls"
                                 constraintName="fk_university_attachmenturls_on_university" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="universities" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="role_id" baseTableName="user_roles"
                                 constraintName="fk_userol_on_role" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="roles" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_roles"
                                 constraintName="fk_userol_on_user" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="users" validate="true"/>
    </changeSet>

    <!--     hozirgi database structure change lari shu file da-->


</databaseChangeLog>